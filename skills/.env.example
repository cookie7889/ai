# Машинно-зависимые пути для скиллов opencode.
# Скопируй в .env и поправь под свою машину. .env не попадает в git.
# Значения: $HOME и ~ раскрываются загрузчиками (bash/node).

# Битрикс24: webhook + b24 (self-locating скрипт)
BITRIX24_DIR=$HOME/.config/opencode/.bitrix24
BITRIX24_WEBHOOK_FILE=$BITRIX24_DIR/webhook
BITRIX24_B24=$BITRIX24_DIR/b24

# Figma: creds (email\npassword) + profile (браузерный профиль)
FIGMA_DIR=$HOME/.config/opencode/.figma

# Временные файлы скиллов
SKILLS_TMP_DIR=$HOME/.config/opencode/skills-data/tmp

# Браузер для figma-скриптов: необязательный override (абсолютный путь или команда).
# Если не задан/не абсолютный — авто-подбор: бандл-chromium из playwright-core,
# затем системный chrome/chromium.
CHROMIUM_PATH=google-chrome
