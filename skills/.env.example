# Машинно-зависимые пути и секреты для скиллов opencode.
# Скопируй в .env (не в git) и заполни. Скиллы на всех ПК одинаковы.
# Значения: $HOME и ~ раскрываются загрузчиками (bash/node/python).

# Битрикс24: полный URL вебхука с завершающим / (НЕ выводить!)
BITRIX24_WEBHOOK=https://imagemark.bitrix24.ru/rest/424/TOKEN/

# Figma: аккаунт для логина (создаст профиль при первом login.mjs)
FIGMA_EMAIL=you@example.com
FIGMA_PASSWORD=

# Папка браузерного профиля Figma (куки/сессия — локальные, не в git)
FIGMA_DIR=$HOME/.config/opencode/.figma

# Временные файлы скиллов
SKILLS_TMP_DIR=$HOME/.config/opencode/skills-data/tmp

# Браузер для figma-скриптов: необязательный override (абсолютный путь или команда).
# Если не задан/не абсолютный — авто-подбор: бандл-chromium из playwright-core.
CHROMIUM_PATH=google-chrome
