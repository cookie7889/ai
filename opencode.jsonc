{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"playwright": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@playwright/mcp@latest",
				"--browser",
				"chromium",
				"--headless"
			],
			"enabled": true
		},
		"bitrix": {
			"type": "remote",
			"url": "https://bxmcp.camouf.ru",
			"enabled": true
		}
	},
	"agent": {
		"title": {
			"model": "opencode/deepseek-v4.1-flash-free"
		}
	}
}